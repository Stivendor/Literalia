        <mxCell id="e9" value="&lt;b&gt;Es atendido por&lt;/b&gt;" style="endArrow=blockThin;endFill=1;html=1;fontSize=10;fontColor=#404040;strokeWidth=1;strokeColor=#707070;endSize=12;rounded=1;edgeStyle=orthogonalEdgeStyle;labelBackgroundColor=#ffffff;jumpStyle=arc;fontFamily=Helvetica;dashed=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c5" target="c4">
