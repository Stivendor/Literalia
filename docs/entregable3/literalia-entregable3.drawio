          <mxGeometry x="1540" y="415" width="30" height="30" as="geometry" />
        </mxCell>
        <mxCell id="c23" value="&lt;b&gt;Regla de negocio:&lt;/b&gt; el stock nunca es negativo. InventarioRepository.modificar_stock() solo actualiza si stock + diferencia ≥ 0; si no, la venta o la salida se rechaza con 409 y el libro conserva su estado." style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#FFF9DB;strokeColor=#D6B656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="300" y="780" width="560" height="130" as="geometry" />
        </mxCell>
        <mxCell id="c24" value="&lt;b&gt;Nota:&lt;/b&gt; editar stock_minimo (PUT /libros/{id}) también puede mover el libro entre Disponible y Bajo Stock. El campo activo existe en LibroModel y la API ya filtra por él, pero el MVP no expone un endpoint para desactivar." style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#FFF9DB;strokeColor=#D6B656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1">
