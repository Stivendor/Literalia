        <mxCell id="e8" value="&lt;b&gt;Inicia sesión, consulta inventario, registra clientes y ventas&lt;/b&gt;&lt;br&gt;[HTTPS]" style="endArrow=blockThin;endFill=1;html=1;fontSize=10;fontColor=#404040;strokeWidth=1;strokeColor=#707070;endSize=12;rounded=1;edgeStyle=orthogonalEdgeStyle;labelBackgroundColor=#ffffff;jumpStyle=arc;fontFamily=Helvetica;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.55;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c4" target="sys">
