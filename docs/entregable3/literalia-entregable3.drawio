        <mxCell id="c7" value="&lt;b&gt;Bajo Stock&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;0 &amp;lt; stock ≤ stock_minimo&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=35;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;fontFamily=Helvetica;" vertex="1" parent="c5">
          <mxGeometry x="600" y="100" width="220" height="70" as="geometry" />
        </mxCell>
        <mxCell id="c8" value="&lt;b&gt;Agotado&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;stock = 0&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=35;fontSize=11;fillColor=#F8CECC;strokeColor=#B85450;fontFamily=Helvetica;" vertex="1" parent="c5">
          <mxGeometry x="335" y="460" width="220" height="70" as="geometry" />
        </mxCell>
        <mxCell id="c9" value="&lt;b&gt;Inactivo&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;activo = false&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=35;fontSize=11;fillColor=#F5F5F5;strokeColor=#999999;fontFamily=Helvetica;dashed=1;" vertex="1" parent="1">
