        <mxCell id="c7" value="&lt;b style=&quot;font-size:12px&quot;&gt;API REST&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[Contenedor: Python · FastAPI, SQLAlchemy 2, Pydantic 2, PyJWT, passlib/bcrypt]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;Reglas de negocio: autenticación JWT con roles, catálogo, movimientos de inventario, clientes y ventas con descuento.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#438DD5;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#3C7FC0;metaEdit=1;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="c5">
          <mxGeometry x="410" y="300" width="340" height="170" as="geometry" />
        </mxCell>
        <mxCell id="c8" value="&lt;b style=&quot;font-size:12px&quot;&gt;Base de datos&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[Contenedor: PostgreSQL (Neon) en producción · SQLite en local]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;Tablas: libros, usuarios, clientes, ventas, detalles_venta, movimientos_inventario.&lt;/span&gt;" style="shape=cylinder3;size=14;whiteSpace=wrap;html=1;boundedLbl=1;rounded=0;labelBackgroundColor=none;fillColor=#438DD5;fontSize=11;fontColor=#ffffff;align=center;strokeColor=#3C7FC0;fontFamily=Helvetica;" vertex="1" parent="c5">
          <mxGeometry x="410" y="550" width="340" height="170" as="geometry" />
        </mxCell>
        <mxCell id="c9" value="&lt;b style=&quot;font-size:12px&quot;&gt;Script crear_admin.py&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[Contenedor: Python CLI]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;Crea el primer administrador leyendo ADMIN_EMAIL y ADMIN_PASSWORD.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#438DD5;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#3C7FC0;metaEdit=1;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="c5">
          <mxGeometry x="880" y="310" width="300" height="150" as="geometry" />
        </mxCell>
        <mxCell id="c15" value="&lt;b&gt;Despliegue:&lt;/b&gt; la SPA y la API viven en un solo proyecto de Vercel con dos &lt;i&gt;services&lt;/i&gt; (vercel.json). Las rutas /api/* van a la API y el resto a la SPA. En local, Vite reenvía /api a Uvicorn :8000 (sin CORS)." style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#FFF9DB;strokeColor=#D6B656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="c5">
          <mxGeometry x="20" y="310" width="330" height="200" as="geometry" />
        </mxCell>
        <mxCell id="e10" value="&lt;b&gt;Usa&lt;/b&gt;&lt;br&gt;[HTTPS · navegador]" style="endArrow=blockThin;endFill=1;html=1;fontSize=10;fontColor=#404040;strokeWidth=1;strokeColor=#707070;endSize=12;rounded=1;edgeStyle=orthogonalEdgeStyle;labelBackgroundColor=#ffffff;jumpStyle=arc;fontFamily=Helvetica;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.3;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c3" target="c6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e11" value="&lt;b&gt;Usa&lt;/b&gt;&lt;br&gt;[HTTPS · navegador]" style="endArrow=blockThin;endFill=1;html=1;fontSize=10;fontColor=#404040;strokeWidth=1;strokeColor=#707070;endSize=12;rounded=1;edgeStyle=orthogonalEdgeStyle;labelBackgroundColor=#ffffff;jumpStyle=arc;fontFamily=Helvetica;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.7;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c4" target="c6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e12" value="&lt;b&gt;Llama a /api/*&lt;/b&gt;&lt;br&gt;[JSON/HTTPS · Authorization: Bearer JWT]" style="endArrow=blockThin;endFill=1;html=1;fontSize=10;fontColor=#404040;strokeWidth=1;strokeColor=#707070;endSize=12;rounded=1;edgeStyle=orthogonalEdgeStyle;labelBackgroundColor=#ffffff;jumpStyle=arc;fontFamily=Helvetica;" edge="1" parent="1" source="c6" target="c7">
