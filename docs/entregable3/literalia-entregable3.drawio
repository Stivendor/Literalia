        <mxCell id="c2" value="Quién usa Literalia y con qué sistemas se relaciona." style="text;html=1;fillColor=none;strokeColor=none;fillColor=none;strokeColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#555555;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="56" width="1500" height="40" as="geometry" />
        </mxCell>
        <mxCell id="c3" value="&lt;b style=&quot;font-size:12px&quot;&gt;Administrador&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[Persona]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;Gestiona catálogo, stock y cuentas de vendedor. También puede vender.&lt;/span&gt;" style="shape=mxgraph.c4.person2;whiteSpace=wrap;html=1;align=center;metaEdit=1;fontSize=11;dashed=0;fillColor=#08427B;strokeColor=#073B6F;fontColor=#ffffff;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="80" y="120" width="200" height="180" as="geometry" />
        </mxCell>
        <mxCell id="c4" value="&lt;b style=&quot;font-size:12px&quot;&gt;Vendedor&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[Persona]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;Consulta inventario, registra clientes y ventas.&lt;/span&gt;" style="shape=mxgraph.c4.person2;whiteSpace=wrap;html=1;align=center;metaEdit=1;fontSize=11;dashed=0;fillColor=#08427B;strokeColor=#073B6F;fontColor=#ffffff;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="500" y="120" width="200" height="180" as="geometry" />
        </mxCell>
        <mxCell id="c5" value="&lt;b style=&quot;font-size:12px&quot;&gt;Cliente comprador&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[Persona externa]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;Compra libros en la librería. No usa el sistema.&lt;/span&gt;" style="shape=mxgraph.c4.person2;whiteSpace=wrap;html=1;align=center;metaEdit=1;fontSize=11;dashed=0;fillColor=#6B6B6B;strokeColor=#5A5A5A;fontColor=#ffffff;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="920" y="120" width="200" height="180" as="geometry" />
        </mxCell>
        <mxCell id="sys" value="&lt;b style=&quot;font-size:12px&quot;&gt;Literalia&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[Sistema de software]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;Gestión de librería: catálogo e inventario de libros, clientes, ventas con descuento y usuarios con roles (admin / vendedor).&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#1168BD;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#0B4884;metaEdit=1;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="380" y="450" width="440" height="170" as="geometry" />
        </mxCell>
        <mxCell id="c6" value="&lt;b style=&quot;font-size:12px&quot;&gt;Gestión de proveedores&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[Sistema · fuera del MVP]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;Aparece en el menú como «Próximamente».&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;fontColor=#666666;align=center;arcSize=10;strokeColor=#999999;dashed=1;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="900" y="470" width="300" height="130" as="geometry" />
        </mxCell>
        <mxCell id="c11" value="&lt;b&gt;Relación con el Entregable 1:&lt;/b&gt; los dos actores (Administrador y Vendedor) corresponden a los roles definidos en los requisitos; el sistema cubre las épicas priorizadas del MVP (autenticación, catálogo/inventario, clientes y ventas). Proveedores quedó fuera del MVP en el story mapping y por eso se muestra punteado." style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#FFF9DB;strokeColor=#D6B656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="80" y="690" width="1120" height="120" as="geometry" />
        </mxCell>
        <mxCell id="e7" value="&lt;b&gt;Inicia sesión, registra libros, movimientos de stock y vendedores&lt;/b&gt;&lt;br&gt;[HTTPS]" style="endArrow=blockThin;endFill=1;html=1;fontSize=10;fontColor=#404040;strokeWidth=1;strokeColor=#707070;endSize=12;rounded=1;edgeStyle=orthogonalEdgeStyle;labelBackgroundColor=#ffffff;jumpStyle=arc;fontFamily=Helvetica;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.2;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c3" target="sys">
