        <mxCell id="c1" value="Patrones de diseño GoF aplicados en Literalia (5 patrones, sin repetir)" style="text;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#1A1A1A;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1400" height="36" as="geometry" />
        </mxCell>
        <mxCell id="c2" value="Cada patrón resuelve una necesidad concreta del MVP. El patrón Repository (Fowler) se usa como apoyo, pero no cuenta dentro de los 5 GoF." style="text;html=1;fillColor=none;strokeColor=none;fillColor=none;strokeColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#555555;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="56" width="1500" height="40" as="geometry" />
        </mxCell>
        <mxCell id="c3" value="1 · Strategy (comportamiento) · descuentos en ventas" style="swimlane;shape=swimlane;html=1;startSize=30;rounded=1;arcSize=1;absoluteArcSize=1;fillColor=#EEEEEE;swimlaneFillColor=#FCFCFC;strokeColor=#9E9E9E;fontStyle=1;fontSize=13;collapsible=0;container=1;recursiveResize=0;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="30" y="110" width="600" height="640" as="geometry" />
        </mxCell>
        <mxCell id="c4" value="&lt;i&gt;«cliente · routes_transacciones.py»&lt;/i&gt;&lt;br&gt;&lt;b&gt;registrar_venta()&lt;/b&gt;" style="verticalAlign=top;align=center;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;rounded=0;fillColor=#F5F5F5;strokeColor=#666666;fontFamily=Helvetica;" vertex="1" parent="c3">
          <mxGeometry x="30" y="50" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="c5" value="&lt;i&gt;«Contexto»&lt;/i&gt;&lt;br&gt;&lt;b&gt;CalculadoraDescuento&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;&lt;span style=&quot;font-size:10px&quot;&gt;- estrategia&lt;br&gt;+ aplicar_descuento(precio)&lt;/span&gt;" style="verticalAlign=top;align=center;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;rounded=0;fillColor=#E1D5E7;strokeColor=#9673A6;fontFamily=Helvetica;" vertex="1" parent="c3">
          <mxGeometry x="30" y="180" width="240" height="90" as="geometry" />
        </mxCell>
        <mxCell id="c6" value="&lt;i&gt;«abstract · Strategy»&lt;/i&gt;&lt;br&gt;&lt;b&gt;EstrategiaDescuento&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;&lt;span style=&quot;font-size:10px&quot;&gt;+ calcular_precio_final(precio)*&lt;/span&gt;" style="verticalAlign=top;align=center;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;rounded=0;fillColor=#E1D5E7;strokeColor=#9673A6;fontFamily=Helvetica;" vertex="1" parent="c3">
          <mxGeometry x="320" y="180" width="250" height="80" as="geometry" />
        </mxCell>
        <mxCell id="c7" value="&lt;i&gt;«ConcreteStrategy»&lt;/i&gt;&lt;br&gt;&lt;b&gt;SinDescuento&lt;/b&gt;" style="verticalAlign=top;align=center;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;rounded=0;fillColor=#E1D5E7;strokeColor=#9673A6;fontFamily=Helvetica;" vertex="1" parent="c3">
          <mxGeometry x="300" y="340" width="130" height="60" as="geometry" />
        </mxCell>
        <mxCell id="c8" value="&lt;i&gt;«ConcreteStrategy»&lt;/i&gt;&lt;br&gt;&lt;b&gt;DescuentoPromocional&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;&lt;span style=&quot;font-size:10px&quot;&gt;- porcentaje&lt;/span&gt;" style="verticalAlign=top;align=center;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;rounded=0;fillColor=#E1D5E7;strokeColor=#9673A6;fontFamily=Helvetica;" vertex="1" parent="c3">
          <mxGeometry x="450" y="340" width="140" height="70" as="geometry" />
        </mxCell>
        <mxCell id="c13" value="&lt;b&gt;Necesidad:&lt;/b&gt; calcular el total de una venta con o sin descuento promocional sin llenar el endpoint de if/else.&lt;br&gt;&lt;b&gt;HU:&lt;/b&gt; HU-05 Registrar venta con descuento.&lt;br&gt;&lt;b&gt;Aplicación:&lt;/b&gt; si porcentaje = 0 se usa SinDescuento; si no, DescuentoPromocional(%). Un descuento nuevo (p. ej. cliente frecuente) es otra subclase, sin tocar CalculadoraDescuento." style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#FFF9DB;strokeColor=#D6B656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="c3">
          <mxGeometry x="20" y="450" width="560" height="170" as="geometry" />
        </mxCell>
        <mxCell id="c14" value="2 · Factory Method (creacional) · creación de libros" style="swimlane;shape=swimlane;html=1;startSize=30;rounded=1;arcSize=1;absoluteArcSize=1;fillColor=#EEEEEE;swimlaneFillColor=#FCFCFC;strokeColor=#9E9E9E;fontStyle=1;fontSize=13;collapsible=0;container=1;recursiveResize=0;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="660" y="110" width="560" height="640" as="geometry" />
        </mxCell>
        <mxCell id="c15" value="&lt;i&gt;«cliente · main.py POST /libros»&lt;/i&gt;&lt;br&gt;&lt;b&gt;crear_libro()&lt;/b&gt;" style="verticalAlign=top;align=center;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;rounded=0;fillColor=#F5F5F5;strokeColor=#666666;fontFamily=Helvetica;" vertex="1" parent="c14">
          <mxGeometry x="40" y="50" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="c16" value="&lt;i&gt;«Creator»&lt;/i&gt;&lt;br&gt;&lt;b&gt;CreadorLibroFactory&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;&lt;span style=&quot;font-size:10px&quot;&gt;+ crear_libro(datos: dict) {static}&lt;/span&gt;" style="verticalAlign=top;align=center;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;rounded=0;fillColor=#E1D5E7;strokeColor=#9673A6;fontFamily=Helvetica;" vertex="1" parent="c14">
          <mxGeometry x="40" y="180" width="260" height="80" as="geometry" />
        </mxCell>
        <mxCell id="c17" value="&lt;i&gt;«Product»&lt;/i&gt;&lt;br&gt;&lt;b&gt;LibroBase&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;&lt;span style=&quot;font-size:10px&quot;&gt;isbn, titulo, autor, categoria, precio, stock=0, stock_minimo=5&lt;/span&gt;" style="verticalAlign=top;align=center;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;rounded=0;fillColor=#E1D5E7;strokeColor=#9673A6;fontFamily=Helvetica;" vertex="1" parent="c14">
          <mxGeometry x="40" y="330" width="260" height="70" as="geometry" />
        </mxCell>
        <mxCell id="c18" value="&lt;i&gt;«ORM»&lt;/i&gt;&lt;br&gt;&lt;b&gt;LibroModel&lt;/b&gt;" style="verticalAlign=top;align=center;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;rounded=0;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontFamily=Helvetica;" vertex="1" parent="c14">
          <mxGeometry x="350" y="330" width="180" height="70" as="geometry" />
        </mxCell>
        <mxCell id="c22" value="&lt;b&gt;Necesidad:&lt;/b&gt; centralizar cómo nace un libro y sus valores por defecto (stock 0, stock mínimo 5) en un solo lugar.&lt;br&gt;&lt;b&gt;HU:&lt;/b&gt; HU-02 Registrar libro.&lt;br&gt;&lt;b&gt;Aplicación:&lt;/b&gt; el endpoint no construye el objeto; delega en CreadorLibroFactory.crear_libro(). Implementado como método de fábrica estático (variante simplificada, sin subclases creadoras)." style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#FFF9DB;strokeColor=#D6B656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="c14">
          <mxGeometry x="20" y="450" width="520" height="170" as="geometry" />
        </mxCell>
        <mxCell id="c23" value="3 · Singleton (creacional) · conexión a la base de datos" style="swimlane;shape=swimlane;html=1;startSize=30;rounded=1;arcSize=1;absoluteArcSize=1;fillColor=#EEEEEE;swimlaneFillColor=#FCFCFC;strokeColor=#9E9E9E;fontStyle=1;fontSize=13;collapsible=0;container=1;recursiveResize=0;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1250" y="110" width="620" height="640" as="geometry" />
        </mxCell>
        <mxCell id="c24" value="&lt;i&gt;«cliente · Depends(get_db)»&lt;/i&gt;&lt;br&gt;&lt;b&gt;Endpoints FastAPI&lt;/b&gt;" style="verticalAlign=top;align=center;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;rounded=0;fillColor=#F5F5F5;strokeColor=#666666;fontFamily=Helvetica;" vertex="1" parent="c23">
          <mxGeometry x="30" y="50" width="260" height="60" as="geometry" />
        </mxCell>
        <mxCell id="c25" value="&lt;i&gt;«Singleton por módulo»&lt;/i&gt;&lt;br&gt;&lt;b&gt;database.py&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;&lt;span style=&quot;font-size:10px&quot;&gt;+ engine: Engine {única}&lt;br&gt;+ SessionLocal: sessionmaker {única}&lt;br&gt;+ get_db(): Session&lt;/span&gt;" style="verticalAlign=top;align=center;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;rounded=0;fillColor=#E1D5E7;strokeColor=#9673A6;fontFamily=Helvetica;" vertex="1" parent="c23">
          <mxGeometry x="30" y="180" width="300" height="110" as="geometry" />
        </mxCell>
        <mxCell id="c26" value="&lt;i&gt;«instance»&lt;/i&gt;&lt;br&gt;&lt;b&gt;engine : Engine&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;&lt;span style=&quot;font-size:10px&quot;&gt;pool de conexiones a Neon / SQLite&lt;/span&gt;" style="verticalAlign=top;align=center;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;rounded=0;fillColor=#FFFFFF;strokeColor=#9673A6;fontFamily=Helvetica;" vertex="1" parent="c23">
          <mxGeometry x="380" y="190" width="210" height="80" as="geometry" />
        </mxCell>
        <mxCell id="c29" value="&lt;b&gt;Necesidad:&lt;/b&gt; compartir un único motor y pool de conexiones a la BD; crear uno por petición agota las conexiones de Neon.&lt;br&gt;&lt;b&gt;HU:&lt;/b&gt; transversal a todas (cada endpoint lee o escribe).&lt;br&gt;&lt;b&gt;Aplicación:&lt;/b&gt; engine y SessionLocal se crean una vez al importar el módulo (Python cachea los módulos en sys.modules, lo que garantiza una instancia por proceso). get_db() entrega una sesión nueva por petición y la cierra. Igual sucede con pwd_context en security.py." style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#FFF9DB;strokeColor=#D6B656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="c23">
          <mxGeometry x="20" y="350" width="580" height="270" as="geometry" />
        </mxCell>
        <mxCell id="c30" value="4 · Chain of Responsibility (comportamiento) · autenticación y autorización" style="swimlane;shape=swimlane;html=1;startSize=30;rounded=1;arcSize=1;absoluteArcSize=1;fillColor=#EEEEEE;swimlaneFillColor=#FCFCFC;strokeColor=#9E9E9E;fontStyle=1;fontSize=13;collapsible=0;container=1;recursiveResize=0;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="30" y="790" width="1000" height="520" as="geometry" />
        </mxCell>
        <mxCell id="c31" value="&lt;i&gt;«Handler 1»&lt;/i&gt;&lt;br&gt;&lt;b&gt;HTTPBearer&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;&lt;span style=&quot;font-size:10px&quot;&gt;extrae el token del header&lt;/span&gt;" style="verticalAlign=top;align=center;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;rounded=0;fillColor=#E1D5E7;strokeColor=#9673A6;fontFamily=Helvetica;" vertex="1" parent="c30">
          <mxGeometry x="30" y="60" width="190" height="80" as="geometry" />
        </mxCell>
        <mxCell id="c32" value="&lt;i&gt;«Handler 2»&lt;/i&gt;&lt;br&gt;&lt;b&gt;usuario_actual()&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;&lt;span style=&quot;font-size:10px&quot;&gt;decodifica JWT, carga usuario activo&lt;/span&gt;" style="verticalAlign=top;align=center;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;rounded=0;fillColor=#E1D5E7;strokeColor=#9673A6;fontFamily=Helvetica;" vertex="1" parent="c30">
          <mxGeometry x="270" y="60" width="210" height="80" as="geometry" />
        </mxCell>
        <mxCell id="c33" value="&lt;i&gt;«Handler 3»&lt;/i&gt;&lt;br&gt;&lt;b&gt;requiere_roles(*roles)&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;&lt;span style=&quot;font-size:10px&quot;&gt;verifica el rol&lt;/span&gt;" style="verticalAlign=top;align=center;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;rounded=0;fillColor=#E1D5E7;strokeColor=#9673A6;fontFamily=Helvetica;" vertex="1" parent="c30">
          <mxGeometry x="530" y="60" width="210" height="80" as="geometry" />
        </mxCell>
        <mxCell id="c34" value="&lt;i&gt;«Receptor final»&lt;/i&gt;&lt;br&gt;&lt;b&gt;Endpoint&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;&lt;span style=&quot;font-size:10px&quot;&gt;crear_libro, registrar_venta…&lt;/span&gt;" style="verticalAlign=top;align=center;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;rounded=0;fillColor=#F5F5F5;strokeColor=#666666;fontFamily=Helvetica;" vertex="1" parent="c30">
          <mxGeometry x="790" y="60" width="180" height="80" as="geometry" />
        </mxCell>
        <mxCell id="c35" value="&lt;i&gt;«corta la cadena»&lt;/i&gt;&lt;br&gt;&lt;b&gt;HTTPException 401 / 403&lt;/b&gt;" style="verticalAlign=top;align=center;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;rounded=0;fillColor=#F8CECC;strokeColor=#B85450;fontFamily=Helvetica;" vertex="1" parent="c30">
          <mxGeometry x="270" y="210" width="470" height="50" as="geometry" />
        </mxCell>
        <mxCell id="c41" value="&lt;b&gt;Necesidad:&lt;/b&gt; que cada endpoint exija token válido, cuenta activa y el rol correcto, sin repetir validaciones en cada función.&lt;br&gt;&lt;b&gt;HU:&lt;/b&gt; HU-01 Iniciar sesión con rol y todas las HU protegidas (HU-02 a HU-05).&lt;br&gt;&lt;b&gt;Aplicación:&lt;/b&gt; FastAPI encadena las dependencias Depends(requiere_roles(&quot;admin&quot;)) → Depends(usuario_actual) → Depends(bearer). Cada eslabón resuelve su parte y la pasa al siguiente, o corta la petición con 401/403. Agregar un control (p. ej. bloqueo por intentos) es un eslabón nuevo." style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#FFF9DB;strokeColor=#D6B656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="c30">
          <mxGeometry x="20" y="290" width="960" height="210" as="geometry" />
        </mxCell>
        <mxCell id="c42" value="5 · Facade (estructural) · cliente API del frontend" style="swimlane;shape=swimlane;html=1;startSize=30;rounded=1;arcSize=1;absoluteArcSize=1;fillColor=#EEEEEE;swimlaneFillColor=#FCFCFC;strokeColor=#9E9E9E;fontStyle=1;fontSize=13;collapsible=0;container=1;recursiveResize=0;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1060" y="790" width="810" height="520" as="geometry" />
        </mxCell>
        <mxCell id="c43" value="&lt;i&gt;«clientes»&lt;/i&gt;&lt;br&gt;&lt;b&gt;Páginas React&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;&lt;span style=&quot;font-size:10px&quot;&gt;Login · Inventario · Ventas · Clientes · Usuarios&lt;/span&gt;" style="verticalAlign=top;align=center;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;rounded=0;fillColor=#F5F5F5;strokeColor=#666666;fontFamily=Helvetica;" vertex="1" parent="c42">
          <mxGeometry x="30" y="60" width="230" height="90" as="geometry" />
        </mxCell>
        <mxCell id="c44" value="&lt;i&gt;«Facade»&lt;/i&gt;&lt;br&gt;&lt;b&gt;api.js&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;&lt;span style=&quot;font-size:10px&quot;&gt;login() · getLibros() · crearVenta() · crearMovimiento() · getClientes() · esAdmin() …&lt;/span&gt;" style="verticalAlign=top;align=center;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;rounded=0;fillColor=#E1D5E7;strokeColor=#9673A6;fontFamily=Helvetica;" vertex="1" parent="c42">
          <mxGeometry x="320" y="50" width="230" height="110" as="geometry" />
        </mxCell>
        <mxCell id="c45" value="&lt;b&gt;fetch + /api&lt;/b&gt;" style="verticalAlign=top;align=center;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;rounded=0;fillColor=#FFFFFF;strokeColor=#999999;fontFamily=Helvetica;" vertex="1" parent="c42">
          <mxGeometry x="600" y="40" width="190" height="40" as="geometry" />
        </mxCell>
