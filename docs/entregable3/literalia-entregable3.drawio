        </mxCell>
        <mxCell id="c6" value="&lt;b style=&quot;font-size:12px&quot;&gt;Aplicación web (SPA)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[Contenedor: JavaScript · React 19, Vite 8, React Router 7]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;Pantallas Login, Inventario, Ventas, Clientes y Usuarios. Oculta opciones según el rol y guarda el JWT en localStorage.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#438DD5;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#3C7FC0;metaEdit=1;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="c5">
